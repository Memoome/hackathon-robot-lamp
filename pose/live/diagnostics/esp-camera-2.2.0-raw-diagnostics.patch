+    if (ctlr->fsm == ESP_CAM_CTLR_SPI_CAM_FSM_STARTED) {
+        uint32_t n = ctlr->diag_count;
+        if (spi_trans->trans_len < spi_trans->length) ctlr->diag_short++;
